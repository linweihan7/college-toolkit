# Copy to .env and fill in what you need. Everything is optional; the app
# reports which features are usable on startup.

# --- Summaries & highlights: pick any provider(s) you have a key for ---
# The UI lets you choose per meeting; SUMMARY_PROVIDER is the default.
# SUMMARY_PROVIDER=claude              # claude | openai | gemini

# Claude (Anthropic)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5        # or claude-opus-5 for the highest quality

# GPT (OpenAI) — also reused by the cloud transcription engine
# OPENAI_SUMMARY_MODEL=gpt-4o

# Gemini (Google)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash       # or gemini-1.5-pro

# --- Cloud transcription engine (optional) ---
OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Local transcription engine (optional; needs requirements-local.txt) ---
# DEFAULT_ENGINE=local               # local | cloud
# LOCAL_WHISPER_MODEL=large-v3       # large-v3 (best) | medium | small | base
# LOCAL_WHISPER_DEVICE=cpu           # cpu | cuda
# LOCAL_WHISPER_COMPUTE=int8         # int8 (fast, CPU) | float16 (GPU) | float32

# --- Speaker diarization (optional; needs requirements-local.txt) ---
# Create a token at https://huggingface.co/settings/tokens and accept the terms
# for pyannote/speaker-diarization-3.1 and pyannote/segmentation-3.0.
HUGGINGFACE_TOKEN=

# --- Traditional Chinese (this app is zh-Hant first) ---
# Recognized Mandarin is converted Simplified -> Traditional. Set false to keep
# whatever the transcriber produced.
# TRADITIONAL_CHINESE=true
# OPENCC_CONFIG=s2t                  # s2t generic | s2twp Taiwan idioms | s2hk Hong Kong

# --- Storage ---
# MEETING_DATA_DIR=./data
